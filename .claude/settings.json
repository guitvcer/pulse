{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-on-edit.sh",
            "timeout": 300,
            "statusMessage": "Running lint and tests..."
          }
        ]
      }
    ]
  }
}
